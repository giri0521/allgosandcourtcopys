# Copy to .env and fill in per environment. Never commit a real .env.

# ---------------------------------------------------------------- database
DB_URL=jdbc:postgresql://localhost:5432/allgos_dms
DB_USERNAME=allgos
DB_PASSWORD=allgos

# ------------------------------------------------------------------ server
SERVER_PORT=8080
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --------------------------------------------------------------------- JWT
# Must be at least 32 bytes and different in every environment.
JWT_SECRET=change-me-in-every-environment-this-must-be-at-least-32-bytes
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# --------------------------------------------------------------------- OTP
# mock  -> the OTP is written to the application log (development only)
# msg91 -> requires DLT-approved templates
OTP_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ----------------------------------------------------------------- storage
# MinIO locally. For real AWS S3, leave S3_ENDPOINT blank and S3_PATH_STYLE false.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=allgos-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE=true

MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=200MB

# -------------------------------------------------------------------- seed
SEED_ADMIN_MOBILE=9999999999
SEED_ADMIN_NAME=System Administrator

# ---------------------------------------------------------------- frontend
VITE_API_TARGET=http://localhost:8080
